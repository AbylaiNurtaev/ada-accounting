generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum LeadSource {
  QUIZ
  MANUAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model QuizSubmission {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  business  String
  budget    String
  comment   String?
  createdAt DateTime @default(now())
  lead      Lead?

  @@map("quiz_submissions")
}

model Lead {
  id               String          @id @default(cuid())
  name             String
  phone            String
  email            String?
  business         String
  budget           String
  comment          String?
  source           LeadSource      @default(QUIZ)
  quizSubmissionId String?         @unique
  quizSubmission   QuizSubmission? @relation(fields: [quizSubmissionId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([createdAt])
  @@index([source])
  @@map("leads")
}

model Case {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  category    String
  images      CaseImage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@index([createdAt])
  @@map("portfolio_cases")
}

model CaseImage {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("case_images")
}
