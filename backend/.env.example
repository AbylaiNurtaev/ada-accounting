# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/digital_agency?schema=public"

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS (comma-separated origins, or * for dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Digital Agency <noreply@agency.test>"
ADMIN_EMAIL=admin@agency.test

# Initial admin (используется prisma seed)
ADMIN_SEED_EMAIL=admin@agency.test
ADMIN_SEED_PASSWORD=ChangeMe123!

# Uploads (относительно корня backend)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880
